{
  "name": "dbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings -- src/bindings.ts",
    "bindings:check": "npm run bindings:generate && git diff --exit-code -- src/bindings.ts",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "vue": "^3.5.41",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "@tauri-apps/cli": "^2"
  },
  "allowScripts": {
    "fsevents": false
  }
}
