{
  "name": "dbox",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "icons:macos": "node scripts/generate-macos-icon.mjs",
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --features bindings --bin export-bindings -- src/bindings.ts",
    "bindings:check": "node scripts/check-bindings.mjs",
    "dev": "vite",
    "dev:http": "node scripts/dev-http.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "3.13.36",
    "@tauri-apps/api": "2.11.1",
    "@vueuse/core": "14.4.0",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "allowScripts": {
    "fsevents": false
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
